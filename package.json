{
  "name": "markdown-chroma",
  "displayName": "Markdown Chroma",
  "description": "Render Obsidian and MyST syntax in VS Code's built-in Markdown preview, without a MyST project.",
  "version": "0.1.0",
  "publisher": "studykit",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/studykit/vscode-markdown-chroma.git"
  },
  "homepage": "https://github.com/studykit/vscode-markdown-chroma#readme",
  "bugs": {
    "url": "https://github.com/studykit/vscode-markdown-chroma/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "obsidian",
    "markdown",
    "preview",
    "wikilink",
    "callout",
    "myst",
    "mystmd",
    "jupyter-book"
  ],
  "main": "./dist/extension.cjs",
  "bin": {
    "markdown-chroma": "./dist/cli.cjs",
    "markdown-chroma-mcp": "./dist/mcp.cjs"
  },
  "exports": {
    "./index": {
      "types": "./dist/types/index/index.d.ts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/extension.cjs",
    "dist/preview-plugin-worker.cjs",
    "dist/preview-plugin-loader.cjs",
    "dist/cli.cjs",
    "dist/index.cjs",
    "dist/mcp.cjs",
    "dist/preview.js",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dist/katex",
    "media/preview.css",
    "media/icon.png",
    "docs/images",
    "docs/CLI.md",
    "docs/PREVIEW.md",
    "docs/CLI-INDEX-SPEC.md",
    "README.md",
    "package.nls.json",
    "LICENSE",
    "docs/MCP.md",
    "dist/types"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onMcpServerDefinitionProvider:markdownChroma.index"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrustDescription%",
      "restrictedConfigurations": [
        "markdownChroma.preview.projectPlugins"
      ]
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css",
      "./dist/katex/katex.min.css"
    ],
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "commands": [
      {
        "command": "obsidianMarkdown.showPreview",
        "title": "Open Preview to the Side",
        "category": "Markdown Chroma"
      },
      {
        "command": "obsidianMarkdown.refreshVault",
        "title": "Refresh Vault Index",
        "category": "Markdown Chroma"
      },
      {
        "command": "markdownChroma.reloadProjectPlugins",
        "title": "Reload Project Plugins",
        "category": "Markdown Chroma"
      },
      {
        "command": "markdownChroma.showProjectPluginLogs",
        "title": "Show Project Plugin Logs",
        "category": "Markdown Chroma"
      }
    ],
    "configuration": {
      "title": "Markdown Chroma",
      "properties": {
        "markdownChroma.preview.root": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Preview file root relative to the workspace folder, or an absolute directory inside it. Empty uses the workspace folder, or the document's containing folder when no workspace is open."
        },
        "markdownChroma.preview.maxEmbedDepth": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "scope": "resource",
          "description": "Maximum nesting depth of note embeds, MyST includes, and MyST embeds. Cycles are stopped earlier."
        },
        "markdownChroma.preview.projectPlugins": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Execute local JavaScript MyST directive and role plugins registered in myst.yml for Preview. Requires a trusted local workspace. Plugins have Node.js file and network access; enable only for projects you trust."
        },
        "markdownChroma.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Offer a saved Markdown/MyST index MCP server for this trusted workspace folder. Requires a VS Code host with the MCP provider API."
        },
        "markdownChroma.mcp.root": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "MCP root relative to this workspace folder, or an absolute directory inside it. Empty uses the workspace folder. Does not use .obsidian configuration."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "markdownChroma.index",
        "label": "Markdown Chroma"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.cjs",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "vscode:prepublish": "npm run build",
    "package": "mkdir -p artifacts && vsce package --no-dependencies --out artifacts/markdown-chroma-0.1.0.vsix"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "8.15.0",
    "github-slugger": "^2.0.0",
    "katex": "0.16.22",
    "lucide": "^1.53.0",
    "markdown-it-mark": "^4.0.0",
    "mermaid": "11.13.0",
    "myst-common": "1.10.1",
    "myst-directives": "1.7.4",
    "myst-ext-button": "0.0.2",
    "myst-ext-card": "1.0.9",
    "myst-ext-exercise": "1.0.10",
    "myst-ext-grid": "1.1.1",
    "myst-ext-proof": "1.0.13",
    "myst-ext-tabs": "1.0.10",
    "myst-frontmatter": "1.10.1",
    "myst-parser": "1.7.4",
    "myst-roles": "1.7.4",
    "myst-transforms": "1.3.51",
    "punycode": "2.3.1",
    "unist-builder": "3.0.1",
    "vfile": "5.3.7",
    "yaml": "^2.8.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.9.3"
  }
}
